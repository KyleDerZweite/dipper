{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dipper",
  "version": "0.1.0",
  "identifier": "io.github.KyleDerZweite.dipper",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dipper",
        "width": 840,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../Logo.png"
    ]
  }
}
